# Ava IDE sidecar — local-dev environment.
# Copy to .env and fill in your keys. The .env file itself is
# gitignored (see packages/ide/.gitignore) — never commit it.
#
# Priority order at runtime: process.env → ~/.ava config → undefined.
# In production, BYOK keys live in the IDE's encrypted config, not here.

# Optional — direct provider keys for local testing without signing in
# (Normal users don't need these; the IDE resolves them from the
# platform account or the provider-key settings page.)
QWEN_API_KEY=
MINIMAX_API_KEY=
