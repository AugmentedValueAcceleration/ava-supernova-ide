{
  "name": "ava-ide-electron",
  "version": "0.2.9",
  "description": "Ava | Supernova — Desktop Application",
  "license": "Apache-2.0",
  "main": "lib/backend/electron-main.js",
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Ava | Supernova",
        "defaultTheme": {
          "light": "ava-light",
          "dark": "ava-dark"
        },
        "defaultIconTheme": "theia-file-icons",
        "electron": {
          "windowOptions": {
            "backgroundColor": "#080810"
          }
        },
        "preferences": {
          "toolbar.showToolbar": false,
          "window.menuBarVisibility": "visible",
          "workbench.startupEditor": "welcomePage",
          "workbench.colorTheme": "ava-dark",
          "editor.fontFamily": "'Cascadia Code', 'Fira Code', 'Consolas', monospace",
          "editor.fontLigatures": true,
          "editor.fontSize": 14,
          "editor.tabSize": 2,
          "editor.detectIndentation": true,
          "editor.wordWrap": "on",
          "editor.minimap.enabled": false,
          "editor.bracketPairColorization.enabled": true,
          "editor.formatOnSave": false,
          "editor.smoothScrolling": true,
          "editor.cursorBlinking": "smooth",
          "editor.cursorSmoothCaretAnimation": "on",
          "editor.lineNumbers": "on",
          "editor.guides.indentation": true,
          "editor.guides.bracketPairs": true,
          "editor.renderWhitespace": "selection",
          "editor.suggestSelection": "first",
          "editor.autoClosingBrackets": "always",
          "editor.autoClosingQuotes": "always",
          "editor.linkedEditing": true,
          "breadcrumbs.enabled": true,
          "files.autoSave": "afterDelay",
          "files.autoSaveDelay": 1000,
          "terminal.integrated.fontSize": 13,
          "terminal.integrated.cursorBlinking": true,
          "scm.defaultViewMode": "tree"
        }
      }
    },
    "backend": {
      "config": {
        "configurationFolder": ".ava-ide",
        "frontendConnectionTimeout": -1,
        "startupTimeout": -1
      }
    }
  },
  "theiaPluginsDir": "../../plugins",
  "theiaPlugins": {
    "vscode.typescript-language-features": "https://open-vsx.org/api/vscode/typescript-language-features/1.95.3/file/vscode.typescript-language-features-1.95.3.vsix",
    "vscode.javascript": "https://open-vsx.org/api/vscode/javascript/1.95.3/file/vscode.javascript-1.95.3.vsix",
    "vscode.json-language-features": "https://open-vsx.org/api/vscode/json-language-features/1.95.3/file/vscode.json-language-features-1.95.3.vsix",
    "vscode.json": "https://open-vsx.org/api/vscode/json/1.95.3/file/vscode.json-1.95.3.vsix",
    "vscode.html-language-features": "https://open-vsx.org/api/vscode/html-language-features/1.95.3/file/vscode.html-language-features-1.95.3.vsix",
    "vscode.html": "https://open-vsx.org/api/vscode/html/1.95.3/file/vscode.html-1.95.3.vsix",
    "vscode.css-language-features": "https://open-vsx.org/api/vscode/css-language-features/1.95.3/file/vscode.css-language-features-1.95.3.vsix",
    "vscode.css": "https://open-vsx.org/api/vscode/css/1.95.3/file/vscode.css-1.95.3.vsix",
    "vscode.markdown-language-features": "https://open-vsx.org/api/vscode/markdown-language-features/1.95.3/file/vscode.markdown-language-features-1.95.3.vsix",
    "vscode.emmet": "https://open-vsx.org/api/vscode/emmet/1.95.3/file/vscode.emmet-1.95.3.vsix",
    "vscode.npm": "https://open-vsx.org/api/vscode/npm/1.95.3/file/vscode.npm-1.95.3.vsix",
    "vscode.git": "https://open-vsx.org/api/vscode/git/1.95.3/file/vscode.git-1.95.3.vsix",
    "vscode.git-base": "https://open-vsx.org/api/vscode/git-base/1.95.3/file/vscode.git-base-1.95.3.vsix",
    "vscode.theme-defaults": "https://open-vsx.org/api/vscode/theme-defaults/1.95.3/file/vscode.theme-defaults-1.95.3.vsix",
    "vscode.python": "https://open-vsx.org/api/vscode/python/1.95.3/file/vscode.python-1.95.3.vsix",
    "ms-python.python": "https://open-vsx.org/api/ms-python/python/2026.2.0/file/ms-python.python-2026.2.0.vsix"
  },
  "dependencies": {
    "@theia/bulk-edit": "1.68.2",
    "@theia/callhierarchy": "1.68.2",
    "@theia/console": "1.68.2",
    "@theia/core": "1.68.2",
    "@theia/debug": "1.68.2",
    "@theia/editor": "1.68.2",
    "@theia/editor-preview": "1.68.2",
    "@theia/electron": "1.68.2",
    "@theia/file-search": "1.68.2",
    "@theia/filesystem": "1.68.2",
    "@theia/getting-started": "1.68.2",
    "@theia/keymaps": "1.68.2",
    "@theia/markers": "1.68.2",
    "@theia/messages": "1.68.2",
    "@theia/monaco": "1.68.2",
    "@theia/navigator": "1.68.2",
    "@theia/outline-view": "1.68.2",
    "@theia/output": "1.68.2",
    "@theia/plugin-ext": "1.68.2",
    "@theia/plugin-ext-vscode": "1.68.2",
    "@theia/preferences": "1.68.2",
    "@theia/process": "1.68.2",
    "@theia/scm": "1.68.2",
    "@theia/search-in-workspace": "1.68.2",
    "@theia/task": "1.68.2",
    "@theia/terminal": "1.68.2",
    "@theia/toolbar": "1.68.2",
    "@theia/typehierarchy": "1.68.2",
    "@theia/userstorage": "1.68.2",
    "@theia/variable-resolver": "1.68.2",
    "@theia/vsx-registry": "1.68.2",
    "@theia/workspace": "1.68.2",
    "ava-agent-extension": "0.1.0",
    "ava-branding-extension": "0.1.0"
  },
  "devDependencies": {
    "@theia/cli": "1.68.2",
    "electron": "38.4.0",
    "electron-builder": "^26.0.12"
  },
  "scripts": {
    "bundle": "yarn rebuild && theia build --mode development",
    "bundle:prod": "yarn rebuild && theia build --mode production",
    "clean": "theia clean",
    "rebuild": "theia rebuild:electron --cacheRoot ..",
    "start": "theia start --plugins=local-dir:../../plugins",
    "watch": "yarn rebuild && theia build --watch --mode development",
    "package": "electron-builder --config electron-builder.yml",
    "package:win": "electron-builder --config electron-builder.yml --win",
    "package:mac": "electron-builder --config electron-builder.yml --mac",
    "package:linux": "electron-builder --config electron-builder.yml --linux"
  }
}
