{
  "name": "ava-agent-extension",
  "version": "0.1.0",
  "description": "Ava | Supernova agent panel — @ava/core integration for Theia IDE",
  "license": "Apache-2.0",
  "keywords": ["theia-extension"],
  "files": ["lib", "src"],
  "main": "lib/browser/ava-agent-frontend-module.js",
  "theiaExtensions": [
    {
      "frontend": "lib/browser/ava-agent-frontend-module",
      "backend": "lib/node/ava-agent-backend-module"
    }
  ],
  "dependencies": {
    "@theia/core": "1.68.2",
    "@theia/editor": "1.68.2",
    "@theia/filesystem": "1.68.2",
    "@theia/terminal": "1.68.2",
    "@theia/workspace": "1.68.2"
  },
  "devDependencies": {
    "typescript": "~5.6.0",
    "rimraf": "^5.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b -w",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "prepare": "yarn build"
  }
}
