{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ava Supernova IDE",
  "version": "0.1.1",
  "identifier": "com.augmentedvalueacceleration.ide",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ava | Supernova IDE",
        "width": 1600,
        "height": 1000,
        "minWidth": 1200,
        "minHeight": 800,
        "decorations": false,
        "center": true,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AugmentedValueAcceleration/ava-supernova-ide/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4N0RENjNCNkYwQjk5NApSV1NVdWZDMlk5MkhDSmZZU29oVDNpNjhVRGFOZzlZa2hncDNTZ2YwZHZMdHdkVEo5NVlsN1FYeAo="
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/node"],
    "resources": ["resources/sidecar-bundle.mjs"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp"
      }
    },
    "iOS": {
      "developmentTeam": "AugmentedValueAcceleration"
    },
    "android": {
    }
  }
}
