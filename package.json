{
  "private": true,
  "name": "ava-supernova-ide",
  "version": "0.2.0",
  "description": "Ava | Supernova IDE — Agent-first development environment",
  "license": "Apache-2.0",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20",
    "yarn": ">=1.7.0 <2"
  },
  "scripts": {
    "postinstall": "node scripts/fix-native-builds.js",
    "build": "yarn build:extensions && yarn build:browser",
    "build:extensions": "lerna run build --scope ava-*",
    "download:plugins": "yarn --cwd electron-app theia download:plugins --ignore-errors",
    "build:electron": "yarn download:plugins && yarn --cwd electron-app bundle",
    "build:browser": "yarn --cwd browser-app bundle",
    "start": "yarn --cwd browser-app start",
    "start:electron": "node scripts/launch-electron.js",
    "start:browser": "yarn --cwd browser-app start",
    "watch": "lerna run --parallel watch",
    "package:electron": "yarn --cwd electron-app package",
    "clean": "lerna run clean && lerna clean -y",
    "prepare": "lerna run prepare"
  },
  "workspaces": [
    "electron-app",
    "browser-app",
    "extensions/*"
  ],
  "devDependencies": {
    "lerna": "^7.4.2"
  }
}
